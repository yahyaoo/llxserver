#!/bin/bash

export PATH=/var/apps/nodejs_v24/target/bin:$PATH
export HOME="${TRIM_PKGVAR}"
DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
APP_DIR="${TRIM_APPDEST}/server"
LOG_FILE="${TRIM_PKGVAR}/info.log"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

# 1. 创建数据目录
mkdir -p "${DATA_DIR}/data" "${DATA_DIR}/logs"

# 2. 安装生产依赖（编译原生模块）
log_msg "Installing dependencies..."
set -o pipefail
cd "${APP_DIR}" && npm ci --omit=dev --no-audit --no-fund 2>&1 | tee -a "${LOG_FILE}" || exit 1

# 3. 初始化 SQL 系统配置；升级保留已配置的数据库，config.js 仅保存库路径。
DATA_PATH="${DATA_DIR}/data" CONFIG_PATH="${DATA_DIR}/config.js" \
node "${APP_DIR}/dist/server/application/persistence/InstallationConfiguration.js" >> "${LOG_FILE}" 2>&1 || exit 1
log_msg "SQLite configuration initialized"

exit 0
